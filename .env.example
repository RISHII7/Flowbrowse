NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon Postgres (pulled by `neon env pull` into .env.local)
# DATABASE_URL is the pooled connection used at runtime; DATABASE_URL_UNPOOLED
# is the direct connection used for migrations / DDL (drizzle-kit).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Trigger.dev — get from the dashboard API Keys page (DEV key starts with tr_dev_)
TRIGGER_SECRET_KEY=

# Liveblocks — secret key from the dashboard (starts with sk_dev_); used server-side
# by lib/liveblocks.ts and the ID-token auth route (app/api/liveblocks/auth).
LIVEBLOCKS_SECRET_KEY=

# Browserbase — API key from the dashboard; used server-side by the run-workflow
# task to open a Stagehand session (env: "BROWSERBASE") for node executors.
BROWSERBASE_API_KEY=

# Resend — API key from the dashboard; used server-side by lib/resend.ts for the
# send-email node executor.
RESEND_API_KEY=

# Sentry — DSN identifies the project events are sent to. Same value for both;
# NEXT_PUBLIC_ is inlined into the browser bundle, SENTRY_DSN is server/edge only.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build-time secret for uploading source maps (generate at
# https://barclays-97.sentry.io/settings/auth-tokens/). Not needed for local dev.
SENTRY_AUTH_TOKEN=